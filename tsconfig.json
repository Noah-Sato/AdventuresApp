{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    "baseUrl": ".",
    "paths": {
      "~/*": ["*"],
      "@assets/*": ["assets/*"],
      "@theme/*": ["src/theme/*"],
      "@components/*": ["src/components/*"],
      "@store/*": ["src/store/*"],
      "@config/*": ["src/config/*"],
      "@hooks/*": ["src/hooks/*"],
      "@src/*": ["src/*"],
      "@contexts/*": ["contexts/*"],
      "@schema/*": ["types/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
